{
  "name": "dsh-hero-headline",
  "version": "1.0.0",
  "description": "Replace the DeepSeek Harness empty-state hero headline（探索未至之境 / Into the Unknown）with custom text, style it as art text, recolor the hero whale, and auto-pick the text gradient from the background (Monet-style palette). Client-only DOM swap, no core changes.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hero",
    "headline",
    "branding",
    "text",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenzhantu/dsh-hero-headline.git"
  },
  "homepage": "https://github.com/shenzhantu/dsh-hero-headline",
  "bugs": {
    "url": "https://github.com/shenzhantu/dsh-hero-headline/issues"
  },
  "license": "MIT"
}